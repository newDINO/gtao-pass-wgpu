// GTAO fragment shader. Ported from three.js' GTAOShader.
// Original: examples/jsm/shaders/GTAOShader.js
// three.js is MIT licensed; see LICENSE-THREEJS.
//
// Shared declarations live in wgsl/common.wgsl and are prepended by
// src/pipeline.rs.

// Depth is bound as an unfilterable float texture rather than
// texture_depth_2d so that textureLoad works on the GL backend.
@group(0) @binding(1) var t_depth: texture_2d<f32>;
@group(0) @binding(2) var t_normal: texture_2d<f32>;

const DIRECTIONS: i32 = 3;
const STEPS: i32 = 6;
const MAGIC_SIZE: u32 = 5u;

// Magic square generated by three.js' generateMagicSquare(5).
const MAGIC_SQUARE: array<u32, 25> = array<u32, 25>(
    9u, 3u, 22u, 16u, 15u,
    2u, 21u, 20u, 14u, 8u,
    25u, 19u, 13u, 7u, 1u,
    18u, 12u, 6u, 5u, 24u,
    11u, 10u, 4u, 23u, 17u,
);

fn get_scene_uv_and_depth(sample_view_pos: vec3f) -> vec3f {
    let clip = u.camera_projection * vec4f(sample_view_pos, 1.0);
    if (clip.w <= 0.0) {
        return vec3f(-1.0, -1.0, 1.0);
    }
    let ndc = clip.xy / clip.w;
    let uv = vec2f(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    return vec3f(uv, get_depth(uv));
}

fn magic_square_angle(pixel: vec2u) -> f32 {
    let x = pixel.x % MAGIC_SIZE;
    let y = pixel.y % MAGIC_SIZE;
    let value = MAGIC_SQUARE[y * MAGIC_SIZE + x];
    return 2.0 * PI * f32(value) / f32(MAGIC_SIZE * MAGIC_SIZE);
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) f32 {
    let uv = in.uv;
    let depth = get_depth(uv);
    if (depth >= 1.0) {
        discard;
    }

    let view_pos = get_view_position(uv, depth);
    let view_normal = get_view_normal(uv);
    let radius = u.radius;
    let distance_exponent = u.distance_exponent;
    let thickness = u.thickness;
    let distance_falloff = u.distance_falloff;

    let pixel = vec2u(uv * vec2f(u.ao_width, u.ao_height));
    let angle = magic_square_angle(pixel);
    let random_vec = vec3f(cos(angle), sin(angle), 0.0);
    let tangent = normalize(random_vec);
    let bitangent = vec3f(-tangent.y, tangent.x, 0.0);
    let kernel_matrix = mat3x3f(tangent, bitangent, vec3f(0.0, 0.0, 1.0));

    var ao = 0.0;
    for (var i: i32 = 0; i < DIRECTIONS; i++) {
        let direction_angle = f32(i) / f32(DIRECTIONS) * PI;
        let sample_dir = normalize(
            kernel_matrix * vec3f(cos(direction_angle), sin(direction_angle), 0.0),
        );

        let view_dir = normalize(-view_pos);
        let slice_bitangent_raw = cross(sample_dir, view_dir);
        let slice_bitangent_len = length(slice_bitangent_raw);
        if (slice_bitangent_len < 1e-6) {
            continue;
        }
        let slice_bitangent = slice_bitangent_raw / slice_bitangent_len;
        let slice_tangent = cross(slice_bitangent, view_dir);
        let normal_in_slice = safe_normalize(
            view_normal - slice_bitangent * dot(view_normal, slice_bitangent),
        );

        let tangent_to_normal_in_slice = cross(normal_in_slice, slice_bitangent);
        var cos_horizons = vec2f(
            dot(view_dir, tangent_to_normal_in_slice),
            dot(view_dir, -tangent_to_normal_in_slice),
        );

        for (var j: i32 = 0; j < STEPS; j++) {
            let step_scale = pow(f32(j + 1) / f32(STEPS), distance_exponent);
            let sample_view_offset = sample_dir * radius * step_scale;

            var sample_scene_uv_depth = get_scene_uv_and_depth(view_pos + sample_view_offset);
            var sample_scene_view_pos =
                get_view_position(sample_scene_uv_depth.xy, sample_scene_uv_depth.z);
            var view_delta = sample_scene_view_pos - view_pos;
            if (abs(view_delta.z) < thickness) {
                let sample_cos_horizon = dot(view_dir, safe_normalize(view_delta));
                let blend = mix(1.0, 2.0 / f32(j + 2), distance_falloff);
                cos_horizons.x += max(0.0, (sample_cos_horizon - cos_horizons.x) * blend);
            }

            sample_scene_uv_depth = get_scene_uv_and_depth(view_pos - sample_view_offset);
            sample_scene_view_pos =
                get_view_position(sample_scene_uv_depth.xy, sample_scene_uv_depth.z);
            view_delta = sample_scene_view_pos - view_pos;
            if (abs(view_delta.z) < thickness) {
                let sample_cos_horizon = dot(view_dir, safe_normalize(view_delta));
                let blend = mix(1.0, 2.0 / f32(j + 2), distance_falloff);
                cos_horizons.y += max(0.0, (sample_cos_horizon - cos_horizons.y) * blend);
            }
        }

        let cos_h = clamp(cos_horizons, vec2f(-1.0), vec2f(1.0));
        let sin_horizons = sqrt(max(vec2f(0.0), vec2f(1.0) - cos_h * cos_h));
        let nx = dot(normal_in_slice, slice_tangent);
        let ny = dot(normal_in_slice, view_dir);
        let nxb = 0.5
            * (acos(cos_h.y) - acos(cos_h.x) + sin_horizons.x * cos_h.x
                - sin_horizons.y * cos_h.y);
        let nyb = 0.5 * (2.0 - cos_h.x * cos_h.x - cos_h.y * cos_h.y);
        ao += nx * nxb + ny * nyb;
    }

    ao = clamp(ao / f32(DIRECTIONS), 0.0, 1.0);
    ao = pow(ao, u.scale);
    return ao;
}
