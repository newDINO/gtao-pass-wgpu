// GTAO fragment shader. Ported from three.js' GTAOShader.

struct Uniforms {
    camera_projection: mat4x4f,
    inv_camera_projection: mat4x4f,
    radius: f32,
    distance_exponent: f32,
    thickness: f32,
    distance_falloff: f32,
    scale: f32,
    normal_mode: f32,
    denoise_rings: f32,
    denoise_radius_exponent: f32,
    ao_width: f32,
    ao_height: f32,
    denoise_luma_phi: f32,
    denoise_depth_phi: f32,
    denoise_normal_phi: f32,
    denoise_radius: f32,
    // Pad the struct to a multiple of 16 bytes for uniform buffer layout.
    _padding: vec2f,
};

@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var t_depth: texture_depth_2d;
@group(0) @binding(2) var t_normal: texture_2d<f32>;

struct VertexOutput {
    @builtin(position) position: vec4f,
    @location(0) uv: vec2f,
};

@vertex
fn vs_main(@builtin(vertex_index) vertex_index: u32) -> VertexOutput {
    var positions = array<vec2f, 3>(
        vec2f(-1.0, -1.0),
        vec2f(3.0, -1.0),
        vec2f(-1.0, 3.0),
    );
    let p = positions[vertex_index];
    var out: VertexOutput;
    out.position = vec4f(p, 0.0, 1.0);
    // WebGPU texture space has its origin in the top-left corner.
    out.uv = vec2f(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
    return out;
}

const PI: f32 = 3.141592653589793;
const DIRECTIONS: i32 = 3;
const STEPS: i32 = 6;
const MAGIC_SIZE: u32 = 5u;

// Magic square generated by three.js' generateMagicSquare(5).
const MAGIC_SQUARE: array<u32, 25> = array<u32, 25>(
    9u, 3u, 22u, 16u, 15u,
    2u, 21u, 20u, 14u, 8u,
    25u, 19u, 13u, 7u, 1u,
    18u, 12u, 6u, 5u, 24u,
    11u, 10u, 4u, 23u, 17u,
);

fn clamp_coord(p: vec2i, size: vec2u) -> vec2i {
    return min(max(p, vec2i(0, 0)), vec2i(size) - vec2i(1, 1));
}

fn safe_normalize(v: vec3f) -> vec3f {
    let len = length(v);
    if (len > 0.0) {
        return v / len;
    }
    return vec3f(0.0);
}

fn fetch_depth(p: vec2i) -> f32 {
    return textureLoad(t_depth, clamp_coord(p, textureDimensions(t_depth)), 0);
}

fn get_depth(uv: vec2f) -> f32 {
    let size = textureDimensions(t_depth);
    let p = vec2i(uv * vec2f(size));
    return textureLoad(t_depth, clamp_coord(p, size), 0);
}

fn get_view_position(uv: vec2f, depth: f32) -> vec3f {
    let ndc = vec2f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    let clip = vec4f(ndc, depth, 1.0);
    let view = u.inv_camera_projection * clip;
    return view.xyz / view.w;
}

fn compute_normal_from_depth(uv: vec2f) -> vec3f {
    let size = textureDimensions(t_depth);
    let size_f = vec2f(size);
    let p = clamp_coord(vec2i(uv * size_f), size);

    let c0 = fetch_depth(p);
    let l2 = fetch_depth(p - vec2i(2, 0));
    let l1 = fetch_depth(p - vec2i(1, 0));
    let r1 = fetch_depth(p + vec2i(1, 0));
    let r2 = fetch_depth(p + vec2i(2, 0));
    let b2 = fetch_depth(p + vec2i(0, 2));
    let b1 = fetch_depth(p + vec2i(0, 1));
    let t1 = fetch_depth(p - vec2i(0, 1));
    let t2 = fetch_depth(p - vec2i(0, 2));

    let dl = abs((2.0 * l1 - l2) - c0);
    let dr = abs((2.0 * r1 - r2) - c0);
    let db = abs((2.0 * b1 - b2) - c0);
    let dt = abs((2.0 * t1 - t2) - c0);

    let ce = get_view_position(uv, c0);
    let texel = vec2f(1.0 / size_f.x, 1.0 / size_f.y);

    var dpdx: vec3f;
    if (dl < dr) {
        dpdx = ce - get_view_position(uv - vec2f(texel.x, 0.0), l1);
    } else {
        dpdx = -ce + get_view_position(uv + vec2f(texel.x, 0.0), r1);
    }

    // Our texture V axis points down (WebGPU), so +V is down on screen.
    var dpdy: vec3f;
    if (db < dt) {
        dpdy = ce - get_view_position(uv + vec2f(0.0, texel.y), b1);
    } else {
        dpdy = -ce + get_view_position(uv - vec2f(0.0, texel.y), t1);
    }

    return safe_normalize(cross(dpdx, dpdy));
}

fn decode_octahedral(p_in: vec2f) -> vec3f {
    var n = vec3f(p_in, 1.0 - abs(p_in.x) - abs(p_in.y));
    if (n.z < 0.0) {
        n = vec3f(
            (1.0 - abs(n.yx)) * select(vec2f(-1.0), vec2f(1.0), n.xy >= vec2f(0.0)),
            n.z,
        );
    }
    return safe_normalize(n);
}

fn get_view_normal(uv: vec2f) -> vec3f {
    let mode = i32(u.normal_mode);
    if (mode == 1 || mode == 2) {
        let size = textureDimensions(t_normal);
        let p = clamp_coord(vec2i(uv * vec2f(size)), size);
        let texel = textureLoad(t_normal, p, 0);
        if (mode == 1) {
            return safe_normalize(texel.xyz);
        }
        return decode_octahedral(texel.xy);
    }
    return compute_normal_from_depth(uv);
}

fn get_scene_uv_and_depth(sample_view_pos: vec3f) -> vec3f {
    let clip = u.camera_projection * vec4f(sample_view_pos, 1.0);
    if (clip.w <= 0.0) {
        return vec3f(-1.0, -1.0, 1.0);
    }
    let ndc = clip.xy / clip.w;
    let uv = vec2f(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    return vec3f(uv, get_depth(uv));
}

fn magic_square_angle(pixel: vec2u) -> f32 {
    let x = pixel.x % MAGIC_SIZE;
    let y = pixel.y % MAGIC_SIZE;
    let value = MAGIC_SQUARE[y * MAGIC_SIZE + x];
    return 2.0 * PI * f32(value) / f32(MAGIC_SIZE * MAGIC_SIZE);
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) f32 {
    let uv = in.uv;
    let depth = get_depth(uv);
    if (depth >= 1.0) {
        discard;
    }

    let view_pos = get_view_position(uv, depth);
    let view_normal = get_view_normal(uv);
    let radius = u.radius;
    let distance_exponent = u.distance_exponent;
    let thickness = u.thickness;
    let distance_falloff = u.distance_falloff;

    let pixel = vec2u(uv * vec2f(u.ao_width, u.ao_height));
    let angle = magic_square_angle(pixel);
    let random_vec = vec3f(cos(angle), sin(angle), 0.0);
    let tangent = normalize(random_vec);
    let bitangent = vec3f(-tangent.y, tangent.x, 0.0);
    let kernel_matrix = mat3x3f(tangent, bitangent, vec3f(0.0, 0.0, 1.0));

    var ao = 0.0;
    for (var i: i32 = 0; i < DIRECTIONS; i++) {
        let direction_angle = f32(i) / f32(DIRECTIONS) * PI;
        let sample_dir = normalize(
            kernel_matrix * vec3f(cos(direction_angle), sin(direction_angle), 0.0),
        );

        let view_dir = normalize(-view_pos);
        let slice_bitangent_raw = cross(sample_dir, view_dir);
        let slice_bitangent_len = length(slice_bitangent_raw);
        if (slice_bitangent_len < 1e-6) {
            continue;
        }
        let slice_bitangent = slice_bitangent_raw / slice_bitangent_len;
        let slice_tangent = cross(slice_bitangent, view_dir);
        let normal_in_slice = safe_normalize(
            view_normal - slice_bitangent * dot(view_normal, slice_bitangent),
        );

        let tangent_to_normal_in_slice = cross(normal_in_slice, slice_bitangent);
        var cos_horizons = vec2f(
            dot(view_dir, tangent_to_normal_in_slice),
            dot(view_dir, -tangent_to_normal_in_slice),
        );

        for (var j: i32 = 0; j < STEPS; j++) {
            let step_scale = pow(f32(j + 1) / f32(STEPS), distance_exponent);
            let sample_view_offset = sample_dir * radius * step_scale;

            var sample_scene_uv_depth = get_scene_uv_and_depth(view_pos + sample_view_offset);
            var sample_scene_view_pos =
                get_view_position(sample_scene_uv_depth.xy, sample_scene_uv_depth.z);
            var view_delta = sample_scene_view_pos - view_pos;
            if (abs(view_delta.z) < thickness) {
                let sample_cos_horizon = dot(view_dir, safe_normalize(view_delta));
                let blend = mix(1.0, 2.0 / f32(j + 2), distance_falloff);
                cos_horizons.x += max(0.0, (sample_cos_horizon - cos_horizons.x) * blend);
            }

            sample_scene_uv_depth = get_scene_uv_and_depth(view_pos - sample_view_offset);
            sample_scene_view_pos =
                get_view_position(sample_scene_uv_depth.xy, sample_scene_uv_depth.z);
            view_delta = sample_scene_view_pos - view_pos;
            if (abs(view_delta.z) < thickness) {
                let sample_cos_horizon = dot(view_dir, safe_normalize(view_delta));
                let blend = mix(1.0, 2.0 / f32(j + 2), distance_falloff);
                cos_horizons.y += max(0.0, (sample_cos_horizon - cos_horizons.y) * blend);
            }
        }

        let cos_h = clamp(cos_horizons, vec2f(-1.0), vec2f(1.0));
        let sin_horizons = sqrt(max(vec2f(0.0), vec2f(1.0) - cos_h * cos_h));
        let nx = dot(normal_in_slice, slice_tangent);
        let ny = dot(normal_in_slice, view_dir);
        let nxb = 0.5
            * (acos(cos_h.y) - acos(cos_h.x) + sin_horizons.x * cos_h.x
                - sin_horizons.y * cos_h.y);
        let nyb = 0.5 * (2.0 - cos_h.x * cos_h.x - cos_h.y * cos_h.y);
        ao += nx * nxb + ny * nyb;
    }

    ao = clamp(ao / f32(DIRECTIONS), 0.0, 1.0);
    ao = pow(ao, u.scale);
    return ao;
}
